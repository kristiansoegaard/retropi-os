#!/usr/bin/env python3
"""RetroPi dashboard - the console's home screen.

Controller or keyboard:
  D-pad / arrows   move          A / Enter    open, play
  B / Esc          back          Y / F        favorite
  L / R  (PgUp/Dn) jump by letter
In a game: hold Start + Select for one second to come back here.
"""
